{
  "manifest_version": 3,
  "name": "Clave — Remplissage automatique",
  "version": "0.4.3",
  "description": "Remplit et propose d’enregistrer les comptes du coffre local Clave.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:32191/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["autofill-core.js"],
      "matches": ["https://*/*"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Clave"
  }
}
