{
  "name": "clave",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "vite build",
    "site": "python website/serve.py 4180",
    "web:preview": "vite preview --host 127.0.0.1 --port 4173",
    "build:mac-local": "tauri build --bundles app --target universal-apple-darwin",
    "build:mac-dmg": "tauri build --bundles dmg --target universal-apple-darwin",
    "icons": "tauri icon src-tauri/icons/icon.png",
    "check": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.js"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-fr": "^4.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}
