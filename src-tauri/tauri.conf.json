{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clave",
  "version": "0.3.0",
  "identifier": "com.clave.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clave",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.pwnedpasswords.com; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4NTQzM0RGOUQzODIwQkUKUldTK0lEaWQzek5VaVB1VHhxeElna0xEWDV6UTdCaFZCckwzZzVOdi9IeVRUOU9vN21Pamx3WG8K",
      "endpoints": [
        "https://github.com/Sch0606/app-mdp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
